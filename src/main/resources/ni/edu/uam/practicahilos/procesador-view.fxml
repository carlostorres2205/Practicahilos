<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilos.ProcesadorController"
      alignment="CENTER"
      spacing="20"
      prefWidth="600"
      prefHeight="450">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Monitor de procesamiento empresarial"
           style="-fx-font-size: 22px;"/>

    <VBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Clientes (100 registros)"
               style="-fx-font-size: 16px;"/>

        <ProgressBar fx:id="barraClientes"
                     progress="0"
                     prefWidth="500"/>

        <Label fx:id="lblClientes"
               text="0% - Esperando inicio"/>

        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnIniciarClientes"
                    text="Iniciar clientes"
                    onAction="#iniciarClientes"/>

            <Button fx:id="btnDetenerClientes"
                    text="Detener clientes"
                    onAction="#detenerClientes"
                    disable="true"/>
        </HBox>
    </VBox>

    <VBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Productos (50 registros)"
               style="-fx-font-size: 16px;"/>

        <ProgressBar fx:id="barraProductos"
                     progress="0"
                     prefWidth="500"/>

        <Label fx:id="lblProductos"
               text="0% - Esperando inicio"/>

        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnIniciarProductos"
                    text="Iniciar productos"
                    onAction="#iniciarProductos"/>

            <Button fx:id="btnDetenerProductos"
                    text="Detener productos"
                    onAction="#detenerProductos"
                    disable="true"/>
        </HBox>
    </VBox>

    <HBox alignment="CENTER" spacing="10">
        <Button text="Simular ambos"
                onAction="#iniciarAmbos"/>

        <Button text="Reiniciar"
                onAction="#reiniciarProceso"/>
    </HBox>

</VBox>
